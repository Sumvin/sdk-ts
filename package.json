{
  "name": "@sumvin/sdk",
  "version": "0.1.2",
  "description": "TypeScript SDK for the Sumvin API \u2014 generated core plus a curated layer.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sumvin/sdk-ts.git"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./signing": {
      "import": {
        "types": "./dist/signing.d.mts",
        "default": "./dist/signing.mjs"
      },
      "require": {
        "types": "./dist/signing.d.cts",
        "default": "./dist/signing.cjs"
      }
    },
    "./generated/client": {
      "import": {
        "types": "./dist/generated/client/index.d.mts",
        "default": "./dist/generated/client/index.mjs"
      },
      "require": {
        "types": "./dist/generated/client/index.d.cts",
        "default": "./dist/generated/client/index.cjs"
      }
    },
    "./generated/*": {
      "import": {
        "types": "./dist/generated/*.d.mts",
        "default": "./dist/generated/*.mjs"
      },
      "require": {
        "types": "./dist/generated/*.d.cts",
        "default": "./dist/generated/*.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "spec:pull": "bun scripts/pull-spec.ts",
    "spec:check": "bun scripts/check-spec-fresh.ts",
    "spec:drift": "bun scripts/check-spec-drift.ts",
    "spec:diff-security": "bun scripts/diff-spec-security.ts",
    "openapi-ts": "openapi-ts",
    "assert:generated": "bun scripts/assert-generated.ts",
    "assert:surfaces": "python3 .claude/scripts/check-surface-registry.py",
    "generate": "bun run openapi-ts && bun run assert:generated",
    "verify:package": "bun run scripts/verify-package.ts",
    "assert:no-mirrored-types": "bun scripts/assert-no-mirrored-types.ts",
    "assert:tsdoc-coverage": "bun scripts/assert-tsdoc-coverage.ts",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "dependencies": {
    "zod": "^4"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5",
    "react": ">=18",
    "viem": ">=2"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@hey-api/shared": "0.5.0",
    "@tanstack/react-query": "^5.90.12",
    "@types/node": "^24.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "viem": "2.55.19",
    "vitest": "^3.2.0"
  }
}
